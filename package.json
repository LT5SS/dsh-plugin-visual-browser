{
  "name": "dsh-plugin-visual-browser",
  "version": "1.4.4",
  "description": "Dual-mode adaptive visual browser subagent plugin for DeepSeek Harness (DSH 0.2.x) with Top-Layer hit-test isolation, persistent settings.json cursor customization, drag/scroll visuals, beforeunload/SESSION_LOST guards, Design HUD, and cumulative findings.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "stage1:verify": "tsx scripts/verify-stage1.ts",
    "stage2:verify": "tsx scripts/verify-stage2.ts",
    "stage3:verify": "tsx scripts/verify-stage3.ts",
    "stage4:verify": "tsx scripts/verify-stage4.ts",
    "test:contract": "tsx scripts/verify-dsh-contract.ts",
    "test:badge": "node scripts/verify-badge-clamp.mjs",
    "test:cursor": "node scripts/verify-cursor-style.mjs",
    "test:matrix": "node scripts/verify-viewport-matrix.mjs",
    "test:design": "node scripts/verify-design-hud.mjs",
    "test:findings": "node scripts/verify-findings.mjs",
    "test:v141": "node scripts/verify-v141.mjs",
    "test:v142": "node scripts/verify-v142.mjs",
    "test:v143": "node scripts/verify-v143.mjs",
    "test:v144": "node scripts/verify-v144.mjs",
    "build": "tsc && node scripts/build-client.mjs"
  },
  "dependencies": {
    "playwright-core": "^1.51.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3",
    "@deepseek-ai/schemastery": ">=3.18.0 <4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "3.19.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
